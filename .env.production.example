# =============================================================================
#  Template do ambiente de PRODUÇÃO (servidor)
# =============================================================================
#  No servidor o .env.production é escrito automaticamente pelo CD
#  (.github/workflows/cd.yml) a partir dos GitHub Secrets, ou manualmente
#  via scripts/setup-env.sh (segredos lidos de variáveis de ambiente).
#
#  Este arquivo serve como referência de todas as chaves necessárias.
#  Nunca comite valores reais.
# =============================================================================

POSTGRES_USER=challenge_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=db_gestao
DB_PORT=5432

PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://challenge_user:CHANGE_ME@db:5432/db_gestao?sslmode=disable
DB_SSL=false

apiKey=your-firebase-api-key
authDomain=your-project.firebaseapp.com
projectId=your-project-id
storageBucket=your-project.firebasestorage.app
messagingSenderId=your-sender-id
appId=your-app-id
measurementId=G-XXXXXXXXXX

FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

FRONTEND_URL=https://your-domain.example
FRONTEND_PORT=3001
SITE_URL=https://your-domain.example/sql-challenge

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=CHANGE_ME
