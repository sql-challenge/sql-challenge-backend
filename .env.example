# ─── Environment ─────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────
# Use full connection string
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/db_gestao?sslmode=disable

# ─── API ──────────────────────────────────────
PORT=3000

# ─── Firebase Client (backend config, lowercase required) ──
# Crie um projeto em https://console.firebase.google.com e copie as credenciais
apiKey=your-api-key
authDomain=your-project.firebaseapp.com
projectId=your-project-id
storageBucket=your-project.appspot.com
messagingSenderId=your-sender-id
appId=your-app-id
measurementId=G-XXXXXXXXXX

# ─── Firebase Admin (backend) ─────────────────
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# ⚠️  Gere uma nova chave privada em:
#   https://console.firebase.google.com/project/your-project/settings/serviceaccounts/adminsdk
FIREBASE_ADMIN_PRIVATE_KEY="substitua-pela-chave-privada"

# ─── CORS / Frontend ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer) ──────────────────────
# Opcional - para enviar e-mails (novos desafios, etc)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ─── URLs ────────────────────────────────────
SITE_URL=http://localhost:3000
