# ─── Environment ─────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=db_gestao
DB_PORT=5432

# ─── API ──────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/db_gestao?sslmode=disable

# ─── Firebase client (used by Next.js frontend) ──
# Crie um projeto em https://console.firebase.google.com e copie as credenciais do Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─── Firebase Admin (backend) ─────────────────
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# ⚠️  Gere uma nova chave privada em:
#   https://console.firebase.google.com/project/your-project/settings/serviceaccounts/adminsdk
FIREBASE_ADMIN_PRIVATE_KEY="substitua-pela-chave-privada"

# ─── CORS / Frontend ─────────────────────────
FRONTEND_URL=http://localhost
FRONTEND_PORT=3000

# ─── Email (Nodemailer) ──────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
SITE_URL=http://localhost:3000
