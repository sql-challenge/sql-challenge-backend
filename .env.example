# ─── Environment ─────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────
# Use full connection string
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/db_gestao?sslmode=disable

# ─── API ──────────────────────────────────────
PORT=3000

# ─── Firebase Client ────────────────────────
# Crie um projeto em https://console.firebase.google.com e copie as credenciais
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Admin ──────────────────────────
# ⚠️  Baixe o JSON da service account em:
#   https://console.firebase.google.com/project/your-project/settings/serviceaccounts/adminsdk
#   Copie os campos client_email e private_key para as variáveis abaixo
#   (FIREBASE_PROJECT_ID já está na seção Firebase Client acima)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----"

# ─── CORS / Frontend ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer) ──────────────────────
# Opcional - para enviar e-mails (novos desafios, etc)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ─── URLs ────────────────────────────────────
SITE_URL=http://localhost:3000
