# =============================================================================
#  Template do ambiente de DESENVOLVIMENTO
# =============================================================================
#  Copie para .env (o `npm run dev` carrega .env automaticamente) e preencha
#  as credenciais do Firebase:
#
#    cp .env.development.example .env
#
#  O banco de dev (db_gestao_dev) é gerenciado por scripts/db-dev.sh —
#  veja DEVELOPMENT.md.
# =============================================================================

# ─── Environment ─────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────
# Banco de dev local (docker-compose.dev.yml / scripts/db-dev.sh)
DATABASE_URL=postgresql://challenge_user:challenge_pass@localhost:5432/db_gestao_dev?sslmode=disable
DB_SSL=false

# ─── API ──────────────────────────────────────
# 3002 na máquina local (3000 é o frontend)
PORT=3002

# ─── Firebase Client ────────────────────────
# Em dev os emuladores substituem o Firebase real. O project-id abaixo é o
# namespace local dos emuladores (prefixo "demo-" nunca toca a nuvem).
# ⚠️  NUNCA use o projeto de produção (sqlmystery) no ambiente de dev.
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-sql-challenge.firebaseapp.com
FIREBASE_PROJECT_ID=demo-sql-challenge
FIREBASE_STORAGE_BUCKET=demo-sql-challenge.appspot.com
FIREBASE_MESSAGING_SENDER_ID=demo-sender
FIREBASE_APP_ID=demo-app
FIREBASE_MEASUREMENT_ID=G-DEMO0000

# ─── Firebase Admin ──────────────────────────
# Em dev os emuladores dispensam credenciais reais (Admin SDK roteia para
# localhost). Os campos abaixo só são necessários para apontar para um
# Firebase real — e isso é bloqueado em dev por padrão (ver DEVELOPMENT.md).
# ⚠️  Baixe o JSON da service account em:
#   https://console.firebase.google.com/project/your-project/settings/serviceaccounts/adminsdk
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----"

# ─── Firebase Emulators (dev) ────────────────
# ⚠️  Em dev NÃO use o projeto Firebase de produção. Rode os emuladores
#     locais (npm run emulators) — o backend recusa iniciar com
#     NODE_ENV=development apontando para a produção sem eles.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# ─── CORS / Frontend ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer) ──────────────────────
# Opcional - para enviar e-mails (novos desafios, etc)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

